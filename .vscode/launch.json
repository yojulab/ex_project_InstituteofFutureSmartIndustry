{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: Debug Server (Port 30013)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev:30013"
    },
    {
      "name": "Next.js: Full Stack (Server + Chrome, Port 30013)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev:30013",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    },
    {
      "name": "Next.js: Attach to Node (Port 30014)",
      "type": "node",
      "request": "attach",
      "port": 30014,
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Next.js: Debug Client (Chrome, Port 30013)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:30013",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
