# ==============================================================================
# 미래스마트산업진흥원 환경 변수 템플릿 (.env.example)
#
# [안내]
# 본 시스템은 코드 내 하드코딩된 디폴트 정보를 허용하지 않습니다.
# 배포 및 실행 전 본 파일을 복사하여 .env 파일을 생성하고 모든 필수 변수를 정의해야 합니다.
#   $ cp .env.example .env
# ==============================================================================

# 1. 데이터베이스 연결 URI (필수)
# 예시: GCP GCE VM 사설망: mongodb://smart_app:PASSWORD@10.x.x.x:27017/smart_industry?authSource=smart_industry
# 예시: Docker 컨테이너 게이트웨이: mongodb://172.22.0.1:27017/smart_industry
# 예시: 로컬 개발망: mongodb://127.0.0.1:27017/smart_industry
MONGODB_URI=

# 2. 세션 암호화 키 (필수, 최소 32자 이상 강력한 무작위 문자열)
SESSION_SECRET=

# 3. 초기 관리자 계정 정보 (필수)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@smartindustry.or.kr
INITIAL_ADMIN_PASSWORD=

# 4. 서비스 네트워크 포트 및 기본 URL
PORT=30013
NEXT_PUBLIC_APP_URL=http://localhost:30013
BASE_URL=http://localhost:30013

# 5. GCP 인프라 및 스토리지 연동 (운영 배포 시 필수)
GCP_PROJECT_ID=smart-industry-portal
GCS_BACKUP_BUCKET=smart-industry-db-backups
GCS_MEDIA_BUCKET=smart-industry-media-storage
STORAGE_DRIVER=local

# 6. 문의하기(Contact) SMTP 메일 발송 설정 (필수)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_MAIL_TO=contact@smartindustry.or.kr
CONTACT_MAIL_FROM="미래스마트산업진흥원 <no-reply@smartindustry.or.kr>"
